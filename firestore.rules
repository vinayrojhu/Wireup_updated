rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function addsOnlyCurrentUser(listBefore, listAfter) {
      return !listBefore.hasAny([request.auth.uid])
        && listAfter.hasAll(listBefore)
        && listAfter.hasAny([request.auth.uid])
        && listAfter.size() == listBefore.size() + 1;
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if signedIn();
      allow update: if (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'uniqueId', 'profile_image', 'following'])
        ) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
          && addsOnlyCurrentUser(resource.data.followers, request.resource.data.followers)
        );
      allow delete: if false;
    }

    match /tweets/{tweetId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        allow update: if signedIn() && (
          resource.data.userId == request.auth.uid || (
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likes', 'likeCount'])
            && addsOnlyCurrentUser(resource.data.likes, request.resource.data.likes)
            && request.resource.data.likeCount == resource.data.likeCount + 1
          )
        );
      }
    }

    match /news/{newsId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /flipnews/{newsId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /YTvideo/{videoId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /PendingUsers/{requestId} {
      allow create: if signedIn() && request.resource.data.uuid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /VerifiedUsers/{verificationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
